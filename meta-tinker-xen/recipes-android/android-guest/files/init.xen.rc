# Android 7 as a headless Xen guest on the Tinker Board (androidboot.hardware=xen).
# Replaces the emulator's init.ranchu.rc: no goldfish pipe, qemud or emulator props.

on early-init
    mount debugfs debugfs /sys/kernel/debug mode=755

on init
    # Never suspend: a suspended Xen guest has nothing to wake it up (it
    # looked like a freeze 1-2 minutes after boot, when the screen timed out)
    write /sys/power/wake_lock xen
    # No input devices in this guest, so ueventd never creates /dev/input,
    # and system_server's InputManager (EventHub) aborts without it
    mkdir /dev/input 0755 root input

on fs
    mount_all /fstab.xen

on post-fs
    # /dev/eac for the audio HAL, before audioserver opens it (/xen-audio.sh)
    exec u:r:su:s0 root root -- /system/bin/sh /xen-audio.sh setup

on boot
    # adb over the Xen bridge: from dom0, "adb connect 192.168.100.3:5555"
    setprop service.adb.tcp.port 5555
    setprop ro.radio.noril yes
    start xen-net
    start xen-audio

# Static address on xenbr0, default route and DNS through dom0 (/xen-net.sh).
# init only starts a service whose SELinux domain it can determine; the
# emulator policy has no domain for a shell script, so name one.
service xen-net /system/bin/sh /xen-net.sh
    seclabel u:r:su:s0
    user root
    group root
    oneshot
    disabled

# Keep the screen on (a bench display, no battery)
on property:sys.boot_completed=1
    start xen-stayon

service xen-stayon /system/bin/sh -c "svc power stayon true; settings put system screen_off_timeout 2147483647"
    seclabel u:r:su:s0
    user root
    group root
    oneshot
    disabled

# Sound to dom0's audio-mixer over xenbr0 (/xen-audio.sh)
service xen-audio /system/bin/sh /xen-audio.sh
    seclabel u:r:su:s0
    user root
    group root audio
    disabled
