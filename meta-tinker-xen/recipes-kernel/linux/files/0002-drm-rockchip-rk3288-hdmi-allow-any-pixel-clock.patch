From: Arjune <arjunevaibhavpatil1434@gmail.com>
Subject: [PATCH] drm/rockchip: rk3288: allow any HDMI pixel clock up to 148.5 MHz

dw_hdmi_rockchip_mode_valid() only accepts the 12 exact pixel clocks of
rockchip_mpll_cfg. Monitors whose modes are all elsewhere end up with no
mode at all: a 7" 1024x600 HDMI panel (EDID: one mode, 49 MHz) gets the
1024x768 no-EDID fallback, which it cannot show, so the screen stays
blank. The MPLL settings are picked by range, so on RK3288 accept any
clock from 25 to 148.5 MHz.

The VOP dot clock could also only divide NPLL's 500 MHz (65 MHz became
62.5, 49 MHz would be 45.5). Let dclk_vop0 retune NPLL (only), and pin
vopb's dclk to NPLL in the Tinker Board DT; NPLL has no other user there
(GMAC runs from ext_gmac). E.g. 1176/24 = 49 MHz, 1560/24 = 65 MHz.

Upstream-Status: Pending
---
diff -ruN a/arch/arm/boot/dts/rk3288-tinker.dtsi b/arch/arm/boot/dts/rk3288-tinker.dtsi
--- a/arch/arm/boot/dts/rk3288-tinker.dtsi
+++ b/arch/arm/boot/dts/rk3288-tinker.dtsi
@@ -528,6 +528,9 @@
 };
 
 &vopb {
+	/* dot clock from NPLL alone, retuned per mode (GMAC uses ext_gmac) */
+	assigned-clocks = <&cru DCLK_VOP0>;
+	assigned-clock-parents = <&cru PLL_NPLL>;
 	status = "okay";
 };
 
diff -ruN a/drivers/clk/rockchip/clk-rk3288.c b/drivers/clk/rockchip/clk-rk3288.c
--- a/drivers/clk/rockchip/clk-rk3288.c
+++ b/drivers/clk/rockchip/clk-rk3288.c
@@ -442,7 +442,9 @@
 			RK3288_CLKSEL_CON(30), 14, 2, MFLAGS, 8, 5, DFLAGS,
 			RK3288_CLKGATE_CON(3), 4, GFLAGS),
 
-	COMPOSITE(DCLK_VOP0, "dclk_vop0", mux_pll_src_cpll_gpll_npll_p, 0,
+	/* NPLL is retuned for the HDMI pixel clock; never touch CPLL/GPLL */
+	COMPOSITE(DCLK_VOP0, "dclk_vop0", mux_pll_src_cpll_gpll_npll_p,
+			CLK_SET_RATE_PARENT | CLK_SET_RATE_NO_REPARENT,
 			RK3288_CLKSEL_CON(27), 0, 2, MFLAGS, 8, 8, DFLAGS,
 			RK3288_CLKGATE_CON(3), 1, GFLAGS),
 	COMPOSITE(DCLK_VOP1, "dclk_vop1", mux_pll_src_cpll_gpll_npll_p, 0,
diff -ruN a/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c b/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c
--- a/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c
+++ b/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c
@@ -393,6 +393,26 @@
 	dw_hdmi_rk3328_read_hpd(dw_hdmi, data);
 }
 
+/*
+ * The RK3288 PHY MPLL settings are selected by range (the first entry at or
+ * above the pixel clock), so any clock up to the last entry can be driven, not
+ * only the exact table values. This lets monitors whose modes are not in the
+ * table work, e.g. 7" 1024x600 panels at 49 MHz. The VOP gets its dot clock
+ * from NPLL, which is retuned for each mode (see clk-rk3288.c).
+ */
+static enum drm_mode_status
+dw_hdmi_rk3288_mode_valid(struct dw_hdmi *hdmi, void *data,
+			  const struct drm_display_info *info,
+			  const struct drm_display_mode *mode)
+{
+	if (mode->clock < 25000)
+		return MODE_CLOCK_LOW;
+	if (mode->clock > 148500)
+		return MODE_CLOCK_HIGH;
+
+	return MODE_OK;
+}
+
 static const struct dw_hdmi_phy_ops rk3228_hdmi_phy_ops = {
 	.init		= dw_hdmi_rockchip_genphy_init,
 	.disable	= dw_hdmi_rockchip_genphy_disable,
@@ -423,7 +443,7 @@
 };
 
 static const struct dw_hdmi_plat_data rk3288_hdmi_drv_data = {
-	.mode_valid = dw_hdmi_rockchip_mode_valid,
+	.mode_valid = dw_hdmi_rk3288_mode_valid,
 	.mpll_cfg   = rockchip_mpll_cfg,
 	.cur_ctr    = rockchip_cur_ctr,
 	.phy_config = rockchip_phy_config,
