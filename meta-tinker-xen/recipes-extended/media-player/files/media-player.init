#!/bin/sh
### BEGIN INIT INFO
# Provides:          media-player
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Play the videos and pictures in MEDIA_DIR on the screen, in a loop
### END INIT INFO
#
# media1 guest: loops everything in MEDIA_DIR on its PV framebuffer (shown on
# a screen of its own by dom0's display-map); the river clip while MEDIA_DIR
# is empty. Files copied in later are picked up on the next round.
# Disable with ENABLED=0 in /etc/default/media-player.

ENABLED=1
FBDEV=/dev/fb0
MEDIA_DIR=/home/root/media
DEFAULT=/usr/share/media-player/sixes-river-800x480.mp4
SECS=5
PIDFILE=/var/run/media-player.pid
LOG=/var/log/media-player.log
[ -r /etc/default/media-player ] && . /etc/default/media-player

case "$1" in
start)
    [ "$ENABLED" = 1 ] || exit 0
    echo "Starting media-player ($MEDIA_DIR on $FBDEV)"
    mkdir -p $MEDIA_DIR
    ( while [ ! -c $FBDEV ]; do sleep 2; done
      while :; do
          if [ -n "$(ls -A $MEDIA_DIR)" ]; then
              media-play -f $FBDEV -d $SECS $MEDIA_DIR
          else
              media-play -f $FBDEV $DEFAULT
          fi
          sleep 1
      done ) >>$LOG 2>&1 </dev/null &
    echo $! > $PIDFILE
    ;;
stop)
    [ -f $PIDFILE ] && kill "$(cat $PIDFILE)" 2>/dev/null
    killall ffmpeg 2>/dev/null
    rm -f $PIDFILE
    ;;
restart)
    $0 stop; $0 start
    ;;
*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
